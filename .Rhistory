#| fig-cap: "Comparison of the observed effect sizes (green, with the grey area illustrating missing non-significant values), and bias-adjusted effect sizes based on an incorrect use of the Type M exaggeration ratio (yellow), and p-uniform (brown)."
#| warning: false
#| message: false
#| echo: false
