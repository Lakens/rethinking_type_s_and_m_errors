data = dplyr::filter(long_data, variable_label != "Observed d"),
aes(y = ..density..),
position = "identity", alpha = 0.5,
binwidth = 0.05, boundary = -0.5,
show.legend = FALSE
) +
# Histogram for Observed d with conditional coloring (ONE binning; no extra legend entry)
