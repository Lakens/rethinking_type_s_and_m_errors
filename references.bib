  file = {C\:\\Users\\dlakens\\Zotero\\storage\\XF5QUXQE\\Kvarven et al_2020_Comparing meta-analyses and preregistered multiple-laboratory replication.pdf;C\:\\Users\\dlakens\\Zotero\\storage\\YJKTTK77\\10.1038@s41562-019-0787-z.pdf}
}

